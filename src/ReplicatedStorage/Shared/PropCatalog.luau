PropCatalog.ById = {}
for _, item in PropCatalog.Items do
	PropCatalog.ById[item.id] = item
end

function PropCatalog.Kg(item, massToKg: number): number
	if item.kg then
		return item.kg
	end
	local s = item.size
	local volume = s.X * s.Y * s.Z
	if item.shape == Enum.PartType.Ball then
		volume *= math.pi / 6
	elseif item.shape == Enum.PartType.Cylinder then
		volume *= math.pi / 4
	end
	return volume * item.density * massToKg
end

return PropCatalog
